# Copier en .env et remplir. Ne jamais committer .env.
# Clés API des serveurs MCP declares dans .mcp.json.

FIRECRAWL_API_KEY=
PERPLEXITY_API_KEY=

# Composio : URL de ton serveur MCP, visible sur son ecran dans le dashboard
# Composio. Elle se termine normalement par /mcp.
COMPOSIO_MCP_URL=
COMPOSIO_API_KEY=
